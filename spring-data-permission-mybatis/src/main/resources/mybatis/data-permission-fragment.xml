<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    Built-in ScopeCondition SQL fragment for data permission filtering.

    Usage in your mapper XML (pass the params map from PermissionQueryBuilder.getSqlParams()):
    <select id="selectWithScope" resultMap="...">
        SELECT * FROM your_table
        WHERE 1=1
        <include refid="io.github.steventsai.permission.ScopeCondition"/>
    </select>

    The mapper method should accept a @Param("params") Map<String, Object> parameter
    containing the parameters produced by PermissionSqlParamAssembler.

    Safety properties:
    - Empty organization lists produce "and 1=0" (fail closed), never an
      unfiltered query.
    - ALL and SELF modes are selected by explicit booleans rather than by a
      missing/empty list.
    - Column names are validated in PermissionSqlParamAssembler before this
      fragment interpolates them with ${...}.
-->
<mapper namespace="io.github.steventsai.permission">
    <sql id="ScopeCondition">
        <if test="params._denyAll">
            and 1=0
        </if>
        <if test="params._selfScope">
            and ${params._ownerUserIdColumn} = #{params.ownerUserId}
        </if>
        <if test="!params._allScope and !params._selfScope
                  and params.authorizedOrgIds != null
                  and params.authorizedOrgIds.size() > 0">
            and ${params._orgIdColumn} in
            <foreach collection="params.authorizedOrgIds" item="orgId" open="(" separator="," close=")">
                #{orgId}
            </foreach>
        </if>
    </sql>
</mapper>
